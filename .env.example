# Copy this file to .env in the project root. Never commit a real .env.
# Normal document intelligence uses the existing local/extractive implementation.
LLM_PROVIDER=extractive

# Groq is used ONLY when Flowchart Analysis is explicitly requested.
VISION_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional model override; if set, this takes precedence over GROQ_VISION_MODEL.
# VISION_MODEL=qwen/qwen3.8-27b
VISION_TIMEOUT_SECONDS=120
VISION_MAX_EDGE=1568
VISION_MAX_TOKENS=8000
VISION_PDF_MAX_PAGES=5

# Optional isolated runtime storage root. Leave unset to preserve backend/data.
# DATA_DIR=C:/path/to/project-data
