# Optional backend environment settings. No file is loaded automatically.
# DATA_DIR=/absolute/path/to/project-data

# No-key working demo. This mode extracts explicit statements using rules.
LLM_PROVIDER=extractive

# Optional configurable LLM mode. Set values in the backend process environment.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-private-api-key
# For a local model server, an HTTP loopback /v1 URL is also supported.
# Never commit a real .env file or keys.
